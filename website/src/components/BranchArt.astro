---
// 「理枝」品牌视觉：抽象枝状连接线。
// 低对比度、纯 SVG 描边，进入视口后路径逐渐绘制。
interface Props {
  class?: string;
  /** 翻转方向（CTA 区使用镜像） */
  flip?: boolean;
}
const { class: cls, flip = false } = Astro.props;
---

<svg
  class:list={['branch-art', cls]}
  viewBox="0 0 640 620"
  fill="none"
  aria-hidden="true"
  data:noscript-still
>
  <g class="strokes" transform={flip ? 'translate(640,0) scale(-1,1)' : undefined}>
    <path class="p p1" d="M50 580 C 130 495, 105 400, 195 348 C 265 307, 300 268, 318 205 C 330 163, 356 132, 392 118" />
    <path class="p p2" d="M150 452 C 215 443, 262 407, 296 400 C 330 393, 356 400, 378 388" />
    <path class="p p3" d="M218 378 C 268 362, 318 368, 368 348 C 420 327, 468 330, 512 300" />
    <path class="p p4" d="M318 205 C 344 170, 382 158, 418 168 C 448 176, 476 170, 498 150" />
    <path class="p p5" d="M318 205 C 306 158, 316 112, 348 78 C 372 52, 410 44, 446 52" />
    <path class="p p6" d="M195 348 C 168 300, 130 280, 92 282" />
  </g>
  <g class="nodes" transform={flip ? 'translate(640,0) scale(-1,1)' : undefined}>
    <circle class="n n1" cx="392" cy="118" r="4.5" />
    <circle class="n n2" cx="378" cy="388" r="3.5" />
    <circle class="n n3" cx="512" cy="300" r="5" />
    <circle class="n n4" cx="498" cy="150" r="3.5" />
    <circle class="n n5" cx="446" cy="52" r="4" />
    <circle class="n n6" cx="92" cy="282" r="3" />
    <circle class="n n7" cx="50" cy="580" r="4" />
  </g>
</svg>

<style>
  .branch-art {
    display: block;
    color: var(--brand);
    pointer-events: none;
    user-select: none;
  }

  .strokes .p {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.22;
  }

  .strokes .p1 {
    stroke-width: 1.8;
    opacity: 0.3;
  }

  .nodes .n {
    fill: currentColor;
    opacity: 0.32;
  }

  /* 进入视口后枝线逐渐绘制、节点依次浮现 */
  .p {
    stroke-dasharray: 720;
    stroke-dashoffset: 720;
    transition: stroke-dashoffset 1.4s var(--ease);
  }

  .n {
    opacity: 0;
    transform: scale(0.3);
    transform-origin: center;
    transform-box: fill-box;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
  }

  :global(.is-in) .p {
    stroke-dashoffset: 0;
  }

  .n {
    transition-delay: 0.7s;
  }

  .n2,
  .n4,
  .n6 {
    transition-delay: 0.9s;
  }

  .n3,
  .n5 {
    transition-delay: 1.05s;
  }

  :global(.is-in) .n {
    opacity: 0.32;
    transform: scale(1);
  }
</style>

<script>
  // 确保 SVG 自身被观察到（放置于背景时父级未必带 .reveal）
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.15 }
  );
  document.querySelectorAll('.branch-art').forEach((el) => io.observe(el));
</script>
