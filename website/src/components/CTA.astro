---
import Icon from './Icon.astro';
import { BASE, LINKS } from '../config';
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta reveal">
      <div class="cta-orbit orbit-one" aria-hidden="true"></div><div
        class="cta-orbit orbit-two"
        aria-hidden="true"
      >
      </div><div class="cta-copy">
        <p class="cta-eyebrow">
          <Icon name="leaf" size={16} /> 少些忙乱，多些从容。
        </p><h2 id="cta-title">校园生活，<br />从这里慢慢理顺。</h2><p>
          下载理枝，把下一周的安排，交给更清晰的自己。
        </p>
      </div><div class="cta-actions">
        <a class="btn cta-download" href={`${BASE}download/`}
          >让理枝加入日常 <Icon name="arrow-right" size={18} /></a
        ><a class="cta-github" href={LINKS.repo} target="_blank" rel="noopener"
          ><Icon name="github" size={15} /> 免费使用，也欢迎一起完善 <Icon
            name="external"
            size={12}
          /></a
        ><span class="cta-meta">开源 · 本地优先 · 为 BIT 同学打造</span>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-bottom: 80px;
  }
  .cta {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 30px;
    align-items: center;
    border-radius: 18px;
    padding: 52px 60px;
    background: #2b4d3d;
    color: #f4f5e9;
    overflow: hidden;
  }
  .cta-copy,
  .cta-actions {
    position: relative;
    z-index: 1;
  }
  .cta-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    letter-spacing: 0.07em;
    color: #bfceac;
    margin-bottom: 17px;
  }
  h2 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 550;
    line-height: 1.4;
    letter-spacing: -0.035em;
  }
  .cta-copy > p:last-child {
    font-size: 11px;
    color: #b4c4b6;
    margin-top: 19px;
  }
  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 40px;
  }
  .cta-download {
    background: #ecf0d9;
    color: #34503c;
    border-radius: 7px;
    padding: 14px 23px;
    min-width: 220px;
    justify-content: space-between;
    font-size: 13px;
  }
  .cta-download:hover {
    background: #f7fae8;
    color: #243b2b;
  }
  .cta-github {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9px;
    color: #ced8c9;
    margin-top: 18px;
  }
  .cta-github:hover {
    color: white;
  }
  .cta-meta {
    margin-top: 24px;
    font-size: 8px;
    letter-spacing: 0.1em;
    color: #b2c0ab;
  }
  .cta-orbit {
    position: absolute;
    width: 520px;
    height: 520px;
    border: 1px solid rgb(190 212 176 / 0.09);
    border-radius: 50%;
    pointer-events: none;
  }
  .orbit-one {
    right: -170px;
    top: -260px;
  }
  .orbit-two {
    right: -80px;
    top: -200px;
  }
  .cta::after {
    content: '';
    position: absolute;
    right: 70px;
    bottom: -190px;
    width: 360px;
    height: 360px;
    border: 1px solid rgb(190 212 176 / 0.07);
    border-radius: 50%;
  }
  @media (max-width: 760px) {
    .cta-section {
      padding-bottom: 48px;
    }
    .cta {
      grid-template-columns: 1fr;
      padding: 35px 28px;
      gap: 27px;
    }
    .cta-actions {
      padding-top: 0;
      align-items: flex-start;
    }
    .cta-eyebrow {
      font-size: 10px;
    }
    h2 {
      font-size: 34px;
    }
    .cta-copy > p:last-child {
      max-width: 23em;
      line-height: 1.9;
    }
    .cta-meta {
      margin-top: 17px;
    }
    .orbit-one {
      right: -340px;
    }
    .orbit-two {
      right: -250px;
    }
  }
</style>
