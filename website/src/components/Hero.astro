---
import Icon from './Icon.astro';
import HeroScene from './HeroScene.astro';
import { BASE, LINKS } from '../config';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grain" aria-hidden="true"></div>
  <div class="container hero-shell">
    <div class="hero-main">
      <div class="hero-intro">
        <div class="hero-heading fade-up">
          <p class="hero-eyebrow">
            <span class="eyebrow-mark"><Icon name="branch" size={14} /></span> 为
            BIT 同学，留一点生活的余地。<span class="eyebrow-line"></span>
          </p>
          <h1 id="hero-title">
            理清日常，<br /><span class="headline-second"
              >自由<span class="hero-emphasis"
                >生长<span class="emphasis-leaf" aria-hidden="true"
                  ><Icon name="leaf" size={25} /></span
                ></span
              >。</span>
          </h1>
          <p class="hero-english" aria-hidden="true">
            Less chaos.<span>More campus.</span>
          </p>
        </div>
        <div class="hero-aside fade-up" style="--reveal-delay: 100ms">
          <p class="hero-sub">
            课表、DDL、成绩，不必来回寻找。<br />让 <strong>BITree 理枝</strong>
            整理琐事，<br
              class="mobile-copy-break"
            />你只管把校园生活过成喜欢的样子。
          </p>
          <div class="hero-actions">
            <a class="btn btn--primary hero-download" href={`${BASE}download/`}
              ><span>让理枝加入日常</span><Icon
                name="arrow-right"
                size={18}
              /></a
            >
            <a
              class="hero-source"
              href={LINKS.repo}
              target="_blank"
              rel="noopener"
              ><Icon name="github" size={17} /><span>免费开源</span><Icon
                name="external"
                size={12}
              /></a
            >
          </div>
          <p class="hero-note">
            <span><Icon name="check" size={12} /> 无广告</span><i></i><span
              >本地优先</span
            ><i></i><span>五端可用</span>
          </p>
        </div>
      </div>
      <div class="hero-visual fade-up" style="--reveal-delay: 180ms">
        <HeroScene />
      </div>
    </div>

    <div class="hero-bottom">
      <div class="hero-service-note">
        <span class="service-kicker">ONE LITTLE APP, LESS LITTLE THINGS.</span
        ><div class="campus-services" aria-label="支持连接的校园服务">
          <span>教学中心</span><i></i><span>乐学</span><i></i><span
            >新延河课堂</span>
        </div>
      </div>
      <a class="hero-scroll" href="#features" aria-label="向下浏览功能概览"
        ><span>往下看看，少一点忙乱</span><span class="scroll-icon"
          ><Icon name="chevron-down" size={17} /></span
        ></a
      >
      <span class="hero-edition" aria-hidden="true"
        >MADE FOR<br /><b>YOUR CAMPUS LIFE.</b></span
      >
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    min-height: calc(100dvh - var(--header-h));
    isolation: isolate;
    overflow: clip;
    background:
      radial-gradient(
        ellipse at 79% 38%,
        color-mix(in srgb, var(--home-stage) 65%, transparent),
        transparent 52%
      ),
      var(--bg);
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      var(--home-grid) 0.8px,
      transparent 0.8px
    );
    background-size: 6px 6px;
    opacity: 0.5;
    z-index: -1;
  }
  .hero-shell {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    width: 100%;
    padding-top: clamp(22px, 4dvh, 52px);
  }
  .hero-main {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    align-items: center;
    gap: 28px;
    padding-block: 12px clamp(12px, 2dvh, 28px);
  }
  .hero-intro {
    position: relative;
    z-index: 1;
    padding-bottom: 8px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: clamp(21px, 3dvh, 34px);
    color: var(--text-2);
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .eyebrow-mark {
    display: inline-flex;
    color: var(--brand);
  }
  .eyebrow-line {
    width: 34px;
    height: 1px;
    background: var(--line-2);
    margin-left: 3px;
  }
  h1 {
    position: relative;
    font-size: clamp(58px, 5.7vw, 82px);
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }
  .headline-second {
    display: inline-block;
    padding-top: 5px;
  }
  .hero-emphasis {
    position: relative;
    color: var(--brand);
    font-family:
      'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC',
      'SimSun', serif;
    font-weight: 500;
    letter-spacing: -0.06em;
  }
  .hero-emphasis::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 2px;
    right: -4px;
    height: 9px;
    border-bottom: 2px solid var(--home-orange);
    border-radius: 50%;
    transform: rotate(-5deg);
  }
  .emphasis-leaf {
    position: absolute;
    top: -11px;
    right: 2px;
    display: inline-flex;
    color: var(--brand);
    transform: rotate(16deg);
  }
  .hero-english {
    font:
      italic clamp(15px, 1.7vw, 22px) / 1.5 Georgia,
      serif;
    color: var(--text-3);
    margin-top: 18px;
    letter-spacing: -0.02em;
  }
  .hero-english span {
    color: var(--brand);
    padding-left: 10px;
  }
  .hero-aside {
    margin-top: clamp(25px, 4dvh, 42px);
  }
  .hero-sub {
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.95;
    letter-spacing: 0.01em;
  }
  .hero-sub strong {
    color: var(--text);
    font-weight: 600;
  }
  .mobile-copy-break {
    display: none;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    margin-top: 24px;
  }
  .hero-download {
    min-width: 194px;
    justify-content: space-between;
    gap: 23px;
    box-shadow: 0 5px 15px color-mix(in srgb, var(--brand) 9%, transparent);
  }
  .hero-source {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 500;
  }
  .hero-source:hover {
    color: var(--brand);
  }
  .hero-source > :global(svg:last-child) {
    color: var(--text-3);
  }
  .hero-note {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--text-3);
    font-size: 9px;
    margin-top: 15px;
  }
  .hero-note > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .hero-note :global(svg) {
    color: var(--brand);
  }
  .hero-note > i {
    height: 2px;
    width: 2px;
    background: currentColor;
    border-radius: 50%;
  }
  .hero-visual {
    min-width: 0;
    position: relative;
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 22px;
    align-items: center;
    border-top: 1px solid var(--line);
    min-height: 92px;
    padding-block: 18px max(18px, env(safe-area-inset-bottom));
  }
  .service-kicker {
    display: block;
    color: var(--text-3);
    font: 7px var(--font-mono);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .campus-services {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    font-weight: 500;
    color: var(--text-2);
  }
  .campus-services i {
    height: 3px;
    width: 3px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--text-2);
    font-size: 9px;
  }
  .scroll-icon {
    width: 28px;
    height: 39px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-2);
    border-radius: 17px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .hero-scroll:hover .scroll-icon {
    border-color: var(--brand);
    transform: translateY(3px);
  }
  .hero-edition {
    justify-self: end;
    color: var(--text-3);
    text-align: right;
    font: 8px/1.8 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .hero-edition b {
    font-weight: 400;
    color: var(--text-2);
  }

  @media (min-width: 1500px) {
    h1 {
      font-size: 86px;
    }
    .hero-main {
      gap: 54px;
    }
    .hero-shell {
      max-width: 1420px;
    }
    .hero-sub {
      font-size: 14px;
    }
    .hero-eyebrow {
      font-size: 12px;
    }
  }
  @media (min-width: 901px) and (max-width: 1200px) {
    h1 {
      font-size: clamp(52px, 5.8vw, 68px);
    }
    .hero-main {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .hero-actions {
      gap: 18px;
    }
    .hero-download {
      min-width: 174px;
    }
    .hero-sub {
      font-size: 12px;
    }
    .hero-eyebrow {
      font-size: 9px;
      gap: 7px;
    }
    .eyebrow-line {
