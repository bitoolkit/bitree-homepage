      padding-top: 12px;
    }
    .hero-main {
      padding-block: 0 13px;
    }
    h1 {
      font-size: clamp(50px, 5vw, 68px);
    }
    .hero-eyebrow {
      margin-bottom: 17px;
    }
    .hero-english {
      margin-top: 11px;
      font-size: 17px;
    }
    .hero-aside {
      margin-top: 20px;
    }
    .hero-actions {
      margin-top: 18px;
    }
    .hero-note {
      margin-top: 12px;
    }
    .hero-bottom {
      min-height: 74px;
      padding-block: 12px;
    }
  }
  @media (min-width: 901px) and (max-height: 600px) {
    h1 {
      font-size: 48px;
    }
    .hero-eyebrow {
      margin-bottom: 12px;
    }
    .hero-english {
      font-size: 15px;
      margin-top: 9px;
    }
    .hero-aside {
      margin-top: 15px;
    }
    .hero-sub {
      font-size: 11px;
      line-height: 1.8;
    }
    .hero-actions {
      margin-top: 15px;
    }
    .hero-note {
      margin-top: 10px;
    }
    .hero-main {
      min-height: 340px;
    }
    .hero-bottom {
      min-height: 61px;
    }
    .service-kicker {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero-shell {
      padding-top: clamp(20px, 3dvh, 32px);
    }
    .hero-main {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 8px;
      padding-block: 0 16px;
    }
    .hero-intro {
      padding: 0;
      text-align: center;
    }
    .hero-eyebrow {
      justify-content: center;
      font-size: 10px;
      margin-bottom: 17px;
    }
    .eyebrow-line {
      display: none;
    }
    h1 {
      font-size: clamp(55px, 8.1vw, 72px);
      line-height: 1.2;
      letter-spacing: -0.06em;
    }
    .headline-second {
      padding-top: 2px;
    }
    .hero-english {
      font-size: 16px;
      margin-top: 14px;
    }
    .hero-aside {
      margin-top: 20px;
    }
    .hero-sub {
      font-size: 12px;
      line-height: 1.85;
    }
    .hero-actions {
      justify-content: center;
      margin-top: 18px;
      gap: 22px;
    }
    .hero-download {
      min-width: 181px;
    }
    .hero-note {
      justify-content: center;
      margin-top: 12px;
    }
    .hero-bottom {
      grid-template-columns: 1fr auto;
      gap: 12px;
      min-height: 70px;
      padding-block: 13px max(13px, env(safe-area-inset-bottom));
    }
    .hero-edition {
      display: none;
    }
    .hero-service-note {
      justify-self: start;
    }
    .hero-scroll > span:first-child {
      display: none;
    }
    .service-kicker {
      font-size: 6px;
      margin-bottom: 7px;
    }
    .campus-services {
      font-size: 9px;
      gap: 11px;
    }
    .scroll-icon {
      height: 31px;
      width: 24px;
    }
  }
  @media (max-width: 540px) {
    .hero-shell {
      padding-top: 21px;
    }
    .hero-main {
      gap: 10px;
      padding-bottom: 12px;
    }
    h1 {
      font-size: clamp(48px, 12.2vw, 61px);
    }
    .hero-eyebrow {
      font-size: 9px;
      gap: 7px;
      margin-bottom: 16px;
    }
    .hero-english {
      font-size: 15px;
      margin-top: 12px;
    }
    .hero-aside {
      margin-top: 17px;
    }
    .hero-sub {
      font-size: 11px;
    }
    .hero-sub > br:first-child {
      display: none;
    }
    .mobile-copy-break {
      display: block;
    }
    .hero-actions {
      margin-top: 17px;
      gap: 20px;
    }
    .hero-actions .btn {
      font-size: 12px;
      padding: 12px 17px;
      min-height: 44px;
    }
    .hero-download {
      min-width: 176px;
      gap: 17px;
    }
    .hero-source {
      font-size: 10px;
      gap: 6px;
    }
    .hero-note {
      font-size: 8px;
      gap: 8px;
      margin-top: 10px;
    }
    .hero-bottom {
      min-height: 62px;
    }
    .emphasis-leaf {
      top: -9px;
      right: 1px;
    }
    .emphasis-leaf :global(svg) {
      width: 19px;
      height: 19px;
    }
  }
  @media (max-width: 375px) {
    h1 {
      font-size: 45px;
    }
    .hero-source > :global(svg:last-child) {
      display: none;
    }
    .hero-actions {
      gap: 13px;
    }
    .hero-download {
      min-width: 165px;
    }
    .hero-eyebrow {
      font-size: 8px;
    }
  }
  @media (max-width: 900px) and (max-height: 780px) {
    .hero-shell {
      padding-top: 17px;
    }
    .hero-main {
      gap: 9px;
      padding-bottom: 8px;
    }
    h1 {
      font-size: 51px;
    }
    .hero-eyebrow {
      margin-bottom: 12px;
    }
    .hero-english {
      margin-top: 10px;
      font-size: 14px;
    }
    .hero-aside {
      margin-top: 15px;
    }
    .hero-actions {
      margin-top: 15px;
    }
    .hero-bottom {
      min-height: 57px;
      padding-block: 10px;
    }
    .hero-note {
      margin-top: 9px;
    }
  }
  @media (max-width: 900px) and (max-height: 680px) {
    .hero-shell {
      padding-top: 12px;
    }
    .hero-main {
      gap: 5px;
      padding-bottom: 5px;
    }
    h1 {
      font-size: 44px;
    }
    .hero-eyebrow {
      margin-bottom: 10px;
      font-size: 8px;
    }
    .hero-english {
      font-size: 13px;
      margin-top: 7px;
    }
    .hero-aside {
      margin-top: 12px;
    }
    .hero-sub {
      font-size: 10px;
      line-height: 1.75;
    }
    .hero-actions {
      margin-top: 12px;
    }
    .hero-note {
      margin-top: 8px;
    }
    .hero-bottom {
      min-height: 50px;
      padding-block: 8px;
    }
    .service-kicker {
      display: none;
    }
    .hero-actions .btn {
      min-height: 41px;
      padding-block: 10px;
    }
  }
  @media (max-width: 900px) and (max-height: 590px) {
    h1 {
      font-size: 39px;
    }
    .hero-eyebrow {
      margin-bottom: 8px;
    }
    .hero-english {
      display: none;
    }
    .hero-aside {
      margin-top: 12px;
    }
    .hero-main {
      gap: 3px;
    }
    .hero-sub {
      font-size: 9px;
    }
    .hero-bottom {
      min-height: 43px;
    }
    .hero-note {
      font-size: 7px;
    }
  }
  @media (min-width: 761px) and (max-width: 900px) and (min-height: 561px) and (max-height: 900px) {
    .hero-main {
      grid-template-columns: 1.05fr 1fr;
      gap: 8px;
    }
    .hero-intro {
      text-align: left;
    }
    .hero-eyebrow,
    .hero-actions,
    .hero-note {
      justify-content: flex-start;
    }
    h1 {
      font-size: 54px;
    }
    .hero-eyebrow {
      font-size: 8px;
    }
    .hero-sub {
      font-size: 11px;
    }
    .hero-actions {
      gap: 15px;
    }
    .hero-download {
      min-width: 169px;
    }
    .hero-actions .btn {
      font-size: 11px;
      padding-inline: 16px;
    }
    .hero-english {
      font-size: 16px;
    }
  }
  @media (orientation: landscape) and (max-width: 900px) and (max-height: 560px) {
    .hero-shell {
      padding-top: 9px;
    }
    .hero-main {
      grid-template-columns: 1.1fr 1fr;
      gap: 0;
      padding-block: 0 5px;
      min-height: 250px;
    }
    .hero-intro {
      text-align: left;
    }
    .hero-eyebrow,
    .hero-actions,
    .hero-note {
      justify-content: flex-start;
    }
    h1 {
      font-size: 38px;
    }
    .hero-eyebrow {
      font-size: 7px;
      margin-bottom: 10px;
    }
    .hero-aside {
      margin-top: 13px;
    }
    .hero-sub {
      font-size: 9px;
    }
    .hero-sub > br:first-child {
      display: none;
    }
    .hero-actions {
      gap: 12px;
      margin-top: 12px;
    }
    .hero-actions .btn {
      font-size: 10px;
      min-height: 35px;
      padding: 8px 12px;
    }
    .hero-download {
      min-width: 150px;
      gap: 10px;
    }
    .hero-source {
      font-size: 9px;
    }
    .hero-source > :global(svg:last-child) {
      display: none;
    }
    .hero-note {
      font-size: 7px;
      margin-top: 7px;
    }
    .hero-english {
      display: none;
    }
    .hero-bottom {
      min-height: 41px;
      padding-block: 7px;
    }
    .service-kicker {
      display: none;
    }
    .campus-services {
      font-size: 8px;
    }
    .scroll-icon {
      width: 21px;
      height: 26px;
    }
  }
  @media (orientation: landscape) and (max-width: 900px) and (max-height: 360px) {
    .hero-shell {
      padding-top: 6px;
    }
    .hero-main {
      min-height: 0;
      padding-bottom: 3px;
    }
    h1 {
      font-size: 31px;
    }
    .hero-eyebrow {
      margin-bottom: 7px;
      font-size: 6px;
    }
    .hero-aside {
      margin-top: 8px;
    }
    .hero-sub {
      font-size: 8px;
      line-height: 1.6;
    }
    .hero-actions {
      margin-top: 9px;
      gap: 10px;
    }
    .hero-actions .btn {
      min-height: 31px;
      padding-block: 6px;
      font-size: 9px;
    }
    .hero-download {
      min-width: 138px;
    }
    .hero-source {
      font-size: 8px;
    }
    .hero-source > :global(svg) {
      width: 13px;
      height: 13px;
    }
    .hero-note {
      margin-top: 5px;
      font-size: 6px;
    }
    .hero-bottom {
      min-height: 34px;
      padding-block: 5px;
    }
    .scroll-icon {
      width: 18px;
      height: 22px;
    }
  }
</style>
