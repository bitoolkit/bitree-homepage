---
import Icon from './Icon.astro';
import { BASE, LINKS } from '../config';
const points = [
  {
    icon: 'offline',
    title: '数据本地保存，不设云端账户',
    desc: '课表、日程与学业数据留在本机，不用注册理枝账号。',
  },
  {
    icon: 'lock',
    title: '凭据与会话，好好保管',
    desc: '学校凭据与可选的 MOOC 会话，使用系统安全存储保存。',
  },
  {
    icon: 'branch',
    title: '直连对应平台，不经理枝中转',
    desc: '不做行为遥测；诊断日志本地保留七天，由你决定是否导出。',
  },
];
---

<section
  class="section privacy-section"
  id="privacy"
  aria-labelledby="privacy-title"
>
  <div class="container privacy-layout">
    <div class="privacy-copy reveal">
      <p class="section-index">02 / 安心，是默认选项</p><h2 id="privacy-title">
        你的校园生活，<br />不必存放在别处。
      </h2><p class="privacy-intro">
        理枝以本地优先的方式工作。<br />课表和日程留在本机，数据由你自己掌握。
      </p><a class="privacy-more" href={`${BASE}features/#g-privacy`}>了解安全性与隐私，以及联网边界 <Icon name="arrow-right" size={15} /></a><a
        href={LINKS.repo}
        class="privacy-source"
        target="_blank"
        rel="noopener"
        ><Icon name="github" size={16} /> 代码开放，安心不只是一句话 <Icon
          name="arrow-right"
          size={15}
        /></a>
    </div>
    <div class="privacy-details reveal" style="--reveal-delay: 100ms">
      <div class="local-label">
        <span><Icon name="lock" size={14} /> LOCAL FIRST, ALWAYS.</span><span
          class="local-indicator"><i></i> 本地优先</span>
      </div><ul role="list">
        {
          points.map((point) => (
            <li>
              <>
                <span class="privacy-icon">
                  <Icon name={point.icon} size={20} />
                </span>
                <div>
                  <>
                    <h3>{point.title}</h3>
                    <p>{point.desc}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ul><div class="privacy-footnote">
        <Icon name="leaf" size={15} /><span
          >一件工具，做好分内的事就够了。</span>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy-section {
    background: var(--home-privacy);
    border-block: 1px solid var(--line);
  }
  .privacy-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(35px, 7vw, 100px);
  }
  h2 {
    font-size: clamp(31px, 3.9vw, 46px);
    letter-spacing: -0.05em;
    font-weight: 600;
    line-height: 1.4;
  }
  .privacy-intro {
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.95;
    margin-top: 22px;
  }
  .privacy-more { display: flex; align-items: center; gap: 8px; width: fit-content; color: var(--brand); font-size: 12px; margin-top: 25px; }
  .privacy-source {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--brand);
    font-size: 11px;
    margin-top: 15px;
  }
  .privacy-source :global(svg:last-child) {
    margin-left: 6px;
  }
  .privacy-details {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    padding: 23px 27px 18px;
  }
  .local-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 18px;
    color: var(--text-3);
    font: 8px var(--font-mono);
    letter-spacing: 0.06em;
  }
  .local-label > span {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .local-label :global(svg) {
    color: var(--brand);
  }
  .local-label .local-indicator {
    font: 9px var(--font-sans);
    letter-spacing: 0;
    color: var(--brand);
  }
  .local-indicator i {
    height: 4px;
    width: 4px;
    border-radius: 50%;
    background: var(--brand);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding-block: 22px;
    border-bottom: 1px solid var(--line);
  }
  li:last-child {
    border: none;
  }
  .privacy-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 37px;
    height: 37px;
    border-radius: 9px;
    border: 1px solid var(--line);
    color: var(--brand);
    background: var(--surface-2);
  }
  h3 {
    font-size: 13px;
    font-weight: 550;
    padding-top: 1px;
  }
  li p {
    margin-top: 6px;
    font-size: 10px;
    color: var(--text-3);
    line-height: 1.8;
  }
  .privacy-footnote {
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 1px dashed var(--line);
    padding-top: 14px;
    font-size: 9px;
    color: var(--text-3);
  }
  .privacy-footnote :global(svg) {
    color: var(--brand);
  }
  @media (max-width: 760px) {
    .privacy-layout {
      grid-template-columns: 1fr;
      gap: 33px;
    }
    h2 {
      font-size: 34px;
    }
    .privacy-intro {
      font-size: 13px;
      margin-top: 18px;
    }
    .privacy-source {
      margin-top: 20px;
    }
    .privacy-details {
      padding: 22px;
    }
  }
  @media (max-width: 390px) {
    .privacy-details {
      padding-inline: 18px;
    }
    .local-label {
      font-size: 7px;
    }
    li {
      gap: 11px;
    }
  }
</style>
