---
import { Icon as IconifyIcon } from 'astro-icon/components';
import { icons } from '../icons/catalog.mjs';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: cls } = Astro.props;
const icon = icons[name as keyof typeof icons];

if (!icon) {
  throw new Error(
    `未配置的图标：${name}。请在 src/icons/catalog.mjs 中选择 Iconify 开源图标。`,
  );
}
---

<IconifyIcon
  name={icon}
  size={size}
  class={cls}
  aria-hidden="true"
  focusable="false"
  is:inline
/>
