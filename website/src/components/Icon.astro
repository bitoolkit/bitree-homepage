            <path d="m11 9.6 1 .8 1-.8M9.6 11.8c-1 1.9-1.6 3.4-1.6 4.4M14.4 11.8c1 1.9 1.6 3.4 1.6 4.4M8.6 19.3l-.8 1.4M15.4 19.3l.8 1.4" />
