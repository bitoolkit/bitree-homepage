          <svg {...common} {...s}>
            <path d="M15.7 7.3c-1.1.06-2.2.7-2.9 1.6-.6.9-.9 2-.7 3.1 1.2.04 2.3-.6 3-1.5.6-.9.9-2.1.6-3.2Z" />
            <path d="M18.4 15.9c-.4 1-.7 1.5-1.3 2.3-.8 1.1-2 2.5-3.4 2.5-1.3 0-1.6-.8-3.3-.8s-2.1.8-3.4.8c-1.4.03-2.5-1.2-3.3-2.3-1.9-2.6-2.2-6.5-.6-8.7 1-1.4 2.6-2.2 4.2-2.2 1.5 0 2.5.8 3.4.8.9 0 2.3-.9 4-.9 1.4 0 2.8.7 3.7 1.9-2.7 1.5-2.5 5.3 0 6.6Z" />
