---
// 统一的线性描边图标集（1.6px 描边、圆角端点），保证全站视觉一致。
// 图标均为简洁几何绘制，不引入外部图标库。
interface Props {
  name: string;
  size?: number;
  class?: string;
  stroke?: boolean;
}
const { name, size = 20, class: cls = '', stroke = true } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  'aria-hidden': 'true',
  ...(cls ? { class: cls } : {}),
};
const s = stroke
  ? {
      stroke: 'currentColor',
      'stroke-width': 1.6,
      'stroke-linecap': 'round',
      'stroke-linejoin': 'round',
    }
  : { fill: 'currentColor' };
---

{
  (() => {
    switch (name) {
      case 'github':
        return (
          <svg {...common} fill="currentColor" stroke="none">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.69 1.25 3.34.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.8 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.77-.01 3.15 0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
          </svg>
        );
      case 'download':
        return (
          <svg {...common} {...s}>
            <path d="M12 4v11" />
            <path d="m7 11 5 5 5-5" class="arr" />
            <path d="M5 20h14" />
          </svg>
        );
      case 'arrow-right':
        return (
          <svg {...common} {...s}>
            <path d="M4 12h15" class="arr" />
            <path d="m13 6 6 6-6 6" />
