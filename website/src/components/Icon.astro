      case 'linux':
        return (
          <svg {...common} {...s}>
            <path d="M12 3.8c2.2 0 3.6 1.9 3.6 4.4 0 1.5-.4 2.4-.4 3.8 0 2.7 1.3 4.2 1.3 5.8 0 .9-.7 1.6-1.6 1.6H9.1c-.9 0-1.6-.7-1.6-1.6 0-1.6 1.3-3.1 1.3-5.8 0-1.4-.4-2.3-.4-3.8 0-2.5 1.4-4.4 3.6-4.4Z" />
