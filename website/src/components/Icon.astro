      case 'windows':
        return (
          <svg {...common} {...s}>
            <path d="M4.5 6.1 10.8 5v6H4.5V6.1ZM12.2 4.8 19.5 3.8v7.2h-7.3V4.8ZM4.5 12.4h6.3v6l-6.3-.9v-5.1ZM12.2 12.4h7.3v7.2l-7.3-1v-6.2Z" />
