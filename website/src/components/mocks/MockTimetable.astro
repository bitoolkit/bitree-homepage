---
import Icon from '../Icon.astro';

// 课表示意界面：按楼栋片区配色的周视图 + 当天时间线。
// 配色与布局规则参考 BITree docs/ui-design.md（综教蓝 / 文萃绿 / 南区黄）。
interface Course {
  d: number; // 0 = 周一
  s: number; // 0 = 第 1 节
  span: number;
  name: string;
  room: string;
  zone: 'a' | 'b' | 'c' | 'n';
  /** 正在上的课（示意） */
  current?: boolean;
}

const courses: Course[] = [
  { d: 0, s: 0, span: 2, name: '高等数学(理)Ⅱ', room: '综教 B-202', zone: 'a' },
  { d: 0, s: 2, span: 2, name: '数据结构', room: '文萃 F-210', zone: 'b' },
  { d: 1, s: 1, span: 2, name: '大学英语Ⅲ', room: '文萃 F-305', zone: 'b' },
  { d: 1, s: 4, span: 2, name: '大学物理实验', room: '南区实验楼 C-108', zone: 'c' },
  { d: 2, s: 0, span: 2, name: '线性代数', room: '综教 A-101', zone: 'a' },
  { d: 2, s: 2, span: 2, name: '思想道德与法治', room: '综教 B-105', zone: 'a' },
  { d: 3, s: 0, span: 2, name: '大学物理', room: '南区理科楼 D-201', zone: 'c' },
  { d: 3, s: 2, span: 2, name: '数据结构', room: '文萃 F-210', zone: 'b', current: true },
  { d: 4, s: 1, span: 2, name: '体育', room: '体育中心', zone: 'n' },
  { d: 4, s: 4, span: 2, name: '大学英语Ⅲ', room: '文萃 F-305', zone: 'b' },
  { d: 5, s: 2, span: 2, name: '心理学导论', room: '综教 A-203', zone: 'a' },
];

const days = ['一', '二', '三', '四', '五', '六', '日'];
const today = 3; // 周四
const periods = 6;
---

<div class="app mock-timetable">
  <div class="app-bar">
    <div>
      <div class="app-title">课表 · 第 8 周</div>
      <div class="app-sub">2026 秋季学期</div>
    </div>
    <span class="spacer"></span>
    <span class="app-chip is-active">回到本周</span>
    <span class="app-icon-btn" aria-hidden="true">
      <Icon name="sort-schedule" size={12} />
    </span>
  </div>

  <div class="app-body timetable">
    <div class="grid">
      <span class="corner"></span>
      {days.map((d, i) => <span class:list={['day', { today: i === today }]}>{d}</span>)}
      {
        Array.from({ length: periods }, (_, p) => (
          <span class="period">{p * 2 + 1}<br />{p * 2 + 2}</span>
        ))
      }
      {
        courses.map((c) => (
          <div
            class:list={['course', `z-${c.zone}`]}
            style={`grid-column: ${c.d + 2}; grid-row: ${c.s + 2} / span ${c.span};`}
          >
            <b>{c.name}</b>
            <i>{c.room}</i>
            {'current' in c && <span class="progress" />}
          </div>
        ))
      }
      <div class="nowline" style={`grid-column: ${today + 2}; grid-row: 2 / -1;`} aria-hidden="true">
        <span class="nowlabel">10:24</span>
      </div>
    </div>
  </div>
</div>

<style>
  .timetable {
    position: relative;
    padding: 10px 12px 14px;
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 22px repeat(7, 1fr);
    grid-auto-rows: minmax(43px, 1fr);
    gap: 3px;
    height: 100%;
    min-height: 0;
  }

  .corner {
    grid-column: 1;
    grid-row: 1;
  }

  .day {
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 620;
    color: #97958b;
    border-radius: 6px;
  }

  .day.today {
    background: #eceae2;
    color: #4d4b43;
  }

  .period {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 9px;
    line-height: 1.15;
    color: #a3a198;
  }

  .course {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    padding: 6px 7px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border: 1px solid transparent;
  }

  .course b {
    font-size: 10px;
    font-weight: 650;
    line-height: 1.32;
    letter-spacing: 0.01em;
  }

  .course i {
    font-style: normal;
    font-size: 8.5px;
    opacity: 0.72;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .z-a {
    background: color-mix(in srgb, var(--bld-a) 18%, #fff);
    border-color: color-mix(in srgb, var(--bld-a) 34%, #fff);
  }

  .z-b {
    background: color-mix(in srgb, var(--bld-b) 16%, #fff);
    border-color: color-mix(in srgb, var(--bld-b) 34%, #fff);
  }

  .z-c {
    background: color-mix(in srgb, var(--bld-c) 20%, #fff);
    border-color: color-mix(in srgb, var(--bld-c) 40%, #fff);
  }

  .z-n {
    background: #efeee8;
    border-color: #dfded5;
  }

  /* 正在上的课：已上部分用同色系强调色填充 */
  .course .progress {
    position: absolute;
    inset: 0;
    width: 45%;
    background: color-mix(in srgb, var(--bld-b) 34%, transparent);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* 当天时间线：贯穿该列 */
  .nowline {
    position: relative;
    border-inline: 1px dashed transparent;
    pointer-events: none;
  }

  .nowline::before {
    content: '';
    position: absolute;
    top: 18%;
    left: 0;
    right: 0;
    height: 2px;
    border-radius: 2px;
    background: #c65a3a;
  }

  .nowlabel {
    position: absolute;
    top: calc(18% - 13px);
    right: 2px;
    font-size: 8px;
    font-weight: 640;
    color: #c65a3a;
    background: #fdf3ef;
    padding: 0 4px;
    border-radius: 4px;
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 18px repeat(5, 1fr);
    }

    .day:nth-child(n + 7),
    .course[style*='grid-column: 7'],
    .course[style*='grid-column: 8'] {
      display: none;
    }
  }
</style>
