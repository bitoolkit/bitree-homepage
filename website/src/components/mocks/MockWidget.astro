---
// Android 桌面小组件示意：单列课程 + 双列日程两种布局（对应 README 描述）。
---

<div class="app mock-widget">
  <div class="home">
    <div class="clock">
      <span class="date">10 月 31 日 周六</span>
      <b>09:41</b>
    </div>

    <div class="widget w-course">
      <div class="w-head">
        <span>今天 · 第 8 周</span>
        <i>课表</i>
      </div>
      <div class="lesson">
        <b>高等数学(理)Ⅱ</b>
        <span>10:00 – 11:40 · 综教 B-202</span>
      </div>
      <div class="lesson next">
        <b>数据结构</b>
        <span>14:00 – 15:40 · 文萃 F-210</span>
      </div>
    </div>

    <div class="widget w-agenda">
      <div class="w-head">
        <span>日程 · 2 项</span>
        <i>DDL</i>
      </div>
      <div class="agenda-row">
        <i class="dot exam"></i>
        <div>
          <b>大学物理 期中考试</b>
          <span>周日 14:00 · 综教 A-305</span>
        </div>
      </div>
      <div class="agenda-row">
        <i class="dot le"></i>
        <div>
          <b>数据结构 实验报告</b>
          <span>周五 23:59 截止</span>
        </div>
      </div>
    </div>

    <div class="dock" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </div>
  </div>
</div>

<style>
  .mock-widget {
    background: linear-gradient(168deg, #eef2ec 0%, #e5ece5 48%, #dfe9e2 100%);
  }

  .home {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 30px 12px 12px;
  }

  .clock {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin-bottom: 4px;
  }

  .clock b {
    font-size: 30px;
    font-weight: 250;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .clock .date {
    font-size: 9.5px;
    color: #6b7369;
  }

  .widget {
    background: rgb(255 255 255 / 0.92);
    border: 1px solid rgb(38 46 40 / 0.07);
    border-radius: 14px;
    padding: 10px 12px;
    box-shadow: 0 6px 18px rgb(30 44 34 / 0.08);
  }

  .w-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 7px;
  }

  .w-head span {
    font-size: 9px;
    font-weight: 640;
    color: #4d544c;
  }

  .w-head i {
    font-style: normal;
    font-size: 8px;
    color: var(--app-copper);
    background: color-mix(in srgb, var(--app-copper) 10%, #fff);
    border-radius: 5px;
    padding: 1px 6px;
    font-weight: 620;
  }

  .lesson {
    border-left: 3px solid var(--bld-a);
    background: color-mix(in srgb, var(--bld-a) 9%, #fff);
    border-radius: 8px;
    padding: 6px 9px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .lesson.next {
    border-left-color: var(--bld-b);
    background: color-mix(in srgb, var(--bld-b) 9%, #fff);
    margin-top: 5px;
    opacity: 0.82;
  }

  .lesson b {
    font-size: 10px;
    font-weight: 650;
  }

  .lesson span {
    font-size: 8.5px;
    color: #7a8178;
  }

  .agenda-row {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 4px 2px;
  }

  .agenda-row + .agenda-row {
    border-top: 1px solid #f0efe9;
  }

  .agenda-row .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-top: 4px;
  }

  .dot.exam {
    background: var(--src-exam);
  }

  .dot.le {
    background: var(--src-leyou);
  }

  .agenda-row b {
    display: block;
    font-size: 9.5px;
    font-weight: 640;
  }

  .agenda-row span {
    font-size: 8.5px;
    color: #7a8178;
  }

  .dock {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    padding: 9px 14px;
    background: rgb(255 255 255 / 0.65);
    border-radius: 16px;
    backdrop-filter: blur(6px);
  }

  .dock i {
    width: 26px;
    height: 26px;
    border-radius: 9px;
    background: linear-gradient(145deg, #cfd8cf, #b8c4b9);
  }
</style>
