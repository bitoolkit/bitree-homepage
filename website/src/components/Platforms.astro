---
import Icon from './Icon.astro';
import { BASE, PLATFORMS } from '../config';
---

<section
  class="section platforms-section"
  id="platforms"
  aria-labelledby="platforms-title"
>
  <div class="container">
    <header class="home-section-heading reveal">
      <div>
        <p class="section-index">03 / 换个设备，依然顺手</p><h2
          id="platforms-title"
        >
          在你习惯的设备上，<br class="mobile-break" />找到理枝。
        </h2>
      </div><p>手机上看课表，电脑上查成绩。<br />五个平台，同样用心。</p>
    </header>
    <div class="platform-grid reveal">
      {
        PLATFORMS.map((platform) => (
          <a class="platform" href={`${BASE}download/?platform=${platform.id}`}>
            <>
              <span class="platform-top">
                <>
                  <Icon
                    name={platform.id === 'macos' ? 'apple' : platform.id}
                    size={27}
                  />
                  <Icon name="arrow-right" size={15} />
                </>
              </span>
              <h3>{platform.name}</h3>
              <p>{platform.format.replace('（未签名）', '')}</p>
              <span class="platform-detail">
                {platform.id === 'ios'
                  ? '需自行签名安装'
                  : platform.id === 'macos'
                    ? 'Intel 与 Apple 芯片'
                    : platform.arch}
              </span>
            </>
          </a>
        ))
      }
    </div>
    <div class="platform-note">
      <p>
        <Icon name="sync" size={14} /> 各设备数据独立保存，换设备后重新同步校园服务即可。
      </p><a href={`${BASE}download/`}
        >安装说明与版本下载 <Icon name="arrow-right" size={14} /></a>
    </div>
  </div>
</section>

<style>
  .platform-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 13px;
    overflow: hidden;
    background: var(--surface);
  }
  .platform {
    display: flex;
    flex-direction: column;
    padding: 25px 23px 22px;
    border-right: 1px solid var(--line);
    color: var(--text);
    transition: background-color 0.2s var(--ease);
  }
  .platform:last-child {
    border: 0;
  }
  .platform:hover {
    background: var(--home-green-card);
    color: var(--brand);
  }
  .platform-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-2);
    margin-bottom: 29px;
  }
  .platform-top > :global(svg:last-child) {
    color: var(--text-3);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }
  .platform:hover .platform-top {
    color: var(--brand);
  }
  .platform:hover .platform-top > :global(svg:last-child) {
    opacity: 1;
    transform: none;
  }
  h3 {
    font-size: 17px;
    font-weight: 550;
    letter-spacing: -0.015em;
  }
  .platform p {
    font-size: 10px;
    color: var(--text-2);
    margin-top: 9px;
  }
  .platform-detail {
    font-size: 8px;
    color: var(--text-3);
    margin-top: 4px;
  }
  .platform-note {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 18px;
    font-size: 10px;
  }
  .platform-note p,
  .platform-note a {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .platform-note p {
    color: var(--text-3);
  }
  .platform-note p :global(svg) {
    flex: none;
  }
  .platform-note a {
    white-space: nowrap;
    color: var(--text-2);
  }
  .platform-note a:hover {
    color: var(--brand);
  }
  .mobile-break {
    display: none;
  }
  @media (max-width: 760px) {
    .platform-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .platform {
      grid-column: span 2;
      padding: 21px 18px;
    }
    .platform:nth-child(3) {
      border-right: 0;
    }
    .platform:nth-child(-n + 3) {
      border-bottom: 1px solid var(--line);
    }
    .platform:nth-child(n + 4) {
      grid-column: span 3;
    }
    .platform-top {
      margin-bottom: 24px;
    }
    .platform-top > :global(svg:last-child) {
      opacity: 1;
      transform: none;
    }
    h3 {
      font-size: 15px;
    }
    .platform-note {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
      font-size: 9px;
    }
    .mobile-break {
      display: block;
    }
  }
</style>
