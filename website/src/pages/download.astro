---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { BASE, PLATFORMS, LINKS, API, type PlatformId } from '../config';


// Linux 有两个架构包，单独定义匹配规则
const assetDefs: Record<string, { label: string; re: RegExp }[]> = {
  android: [{ label: 'arm64-v8a APK', re: /-android-arm64-v8a\.apk$/i }],
  windows: [{ label: 'x64 EXE', re: /-windows-x64.*\.exe$/i }],
  macos: [{ label: '通用版 ZIP', re: /-macos-universal.*\.zip$/i }],
  linux: [
    { label: 'x64 tar.xz', re: /-linux-x64\.tar\.xz$/i },
    { label: 'aarch64 tar.xz', re: /-linux-arm64\.tar\.xz$/i },
  ],
  ios: [{ label: 'arm64 IPA（未签名）', re: /-ios-arm64.*\.ipa$/i }],
};

const notes: Record<PlatformId, string[]> = {
  android: ['下载后直接安装；如提示未知来源，允许安装本应用即可。', '安装后可在桌面添加课程与日程小组件。'],
  windows: ['安装包已包含运行依赖，按安装向导完成安装即可。'],
  macos: ['当前版本未签名：解压后首次打开若被拦截，前往「系统设置 → 隐私与安全性」点击「仍要打开」。'],
  linux: ['解压后运行目录中的 bitree 即可，无需安装。', '提供 x64 与 aarch64 两种架构，按处理器选择。'],
  ios: ['IPA 未签名，需使用自签工具或开发者证书签名后侧载安装。', '具体步骤可查看 GitHub Releases 页面的说明。'],
};

const formatMap: Record<PlatformId, string> = {
  android: 'APK 安装包',
  windows: 'EXE 安装包',
  macos: 'ZIP 压缩包',
  linux: 'tar.xz 压缩包',
  ios: 'IPA 安装包',
};
---

<Base
  title="下载"
  description="下载 BITree 理枝：Android APK、Windows EXE、macOS 通用版、Linux tar.xz 与 iOS IPA，安装包来自 GitHub Releases，版本随发布自动更新。"
>
  <div class="container">
    <header class="page-head reveal">
      <p class="kicker">下载</p>
      <h1>选择你的平台，开始使用 BITree。</h1>
      <p>安装包来自 GitHub Releases，版本号与下载地址随发布自动更新，本页不维护任何硬编码版本。</p>
    </header>

    <p class="detect-hint reveal" data-detect-hint hidden>
      <Icon name="check" size={15} />
      已识别你的系统为 <b data-detect-name></b>，已为你选中对应平台，你也可以手动切换。
    </p>

    <div class="dl-layout reveal">
      <div class="dl-picker" role="tablist" aria-label="选择操作系统" data-dl-tabs>
        {
          PLATFORMS.map((p, i) => (
            <button
              type="button"
              role="tab"
              class="dl-tab"
              id={`dl-tab-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`dl-panel-${p.id}`}
              tabindex={i === 0 ? 0 : -1}
              data-platform={p.id}
            >
              <Icon name={p.id} size={21} />
              <span>{p.name}</span>
            </button>
          ))
        }
      </div>

      <div class="dl-panels">
        {
          PLATFORMS.map((p, i) => (
            <section
              class="dl-panel"
              role="tabpanel"
              id={`dl-panel-${p.id}`}
              aria-labelledby={`dl-tab-${p.id}`}
              hidden={i !== 0}
              data-panel={p.id}
            >
              <div class="dl-head">
                <span class="dl-icon">
                  <Icon name={p.id} size={26} />
                </span>
                <div>
                  <h2>{p.name}</h2>
                  <p class="dl-meta">
                    <span>{p.arch}</span>
                    <i />
                    <span>{formatMap[p.id]}</span>
                  </p>
                </div>
                <p class="dl-version" data-slot="version">
                  正在获取最新版本…
                </p>
              </div>

              <div class="dl-actions" data-actions>
                {(assetDefs[p.id] ?? []).map((a, ai) => (
                  <a
                    class:list={['btn', ai === 0 ? 'btn--primary' : 'btn--ghost', 'dl-btn']}
                    href={LINKS.releasesLatest}
                    data-asset-re={a.re.source}
                    data-asset-label={a.label}
                  >
                    <Icon name="download" size={17} />
                    <span data-btn-text>下载 {a.label}</span>
                  </a>
                ))}
                <a class="link-quiet dl-alt" href={LINKS.releases} target="_blank" rel="noopener">
                  全部版本与历史发布
                  <Icon name="external" size={14} />
                </a>
              </div>

              <ul class="dl-notes">
                {notes[p.id].map((n) => (
                  <li>{n}</li>
                ))}
              </ul>

              <p class="dl-sums">
                <a href={LINKS.releasesLatest} target="_blank" rel="noopener" data-slot="sums">
                  校验文件 SHA256SUMS.txt
                </a>
                <span class="dl-size" data-slot="size" hidden />
              </p>
            </section>
          ))
        }

        <p class="dl-notice" data-dl-notice hidden>
          <Icon name="alert" size={15} />
          版本信息暂时无法获取（可能是网络原因或 GitHub API 限流），下载按钮已改为打开
          Releases 页面，可在其中手动选择安装包。
        </p>
        <noscript>
          <p class="dl-notice">
            <Icon name="alert" size={15} />
            浏览器未启用 JavaScript，无法自动匹配最新版本，请直接前往
            <a href={LINKS.releases} target="_blank" rel="noopener">GitHub Releases</a> 选择对应平台的安装包。
          </p>
        </noscript>
      </div>
    </div>

    <!-- 测试版通道 -->
    <section class="dev-channel reveal" aria-labelledby="dev-title">
      <div class="dev-info">
        <span class="dev-badge">开发测试版</span>
        <h2 id="dev-title">想抢先尝试新功能？</h2>
        <p>
          测试版包含尚未正式发布的功能改动，<b>可能不稳定</b>，不建议作为日常主力版本。
          当前最新测试版：<b data-slot="dev-version">正在获取…</b>
        </p>
      </div>
      <a class="btn btn--ghost" href={LINKS.releasesPrerelease} target="_blank" rel="noopener" data-slot="dev-link">
        <Icon name="github" size={16} />
        前往测试版发布页
      </a>
    </section>

    <p class="dl-foot reveal">
      理枝以 Unlicense 免费发布。安装或升级遇到问题？先看
      <a href={`${BASE}help/`}>使用帮助</a>，或到
      <a href={LINKS.issues} target="_blank" rel="noopener">GitHub Issues</a> 反馈。
    </p>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(40px, 6vw, 72px) clamp(20px, 3vw, 32px);
    max-width: 680px;
  }

  .page-head h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
  }

  .page-head p {
    margin-top: 14px;
    color: var(--text-2);
  }

  .detect-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 18px;
    padding: 10px 14px;
    border-radius: var(--radius-s);
    background: var(--brand-soft);
    color: var(--text);
    font-size: 0.875rem;
    border: 1px solid var(--brand-line);
  }

  /* display 规则会覆盖 UA 的 [hidden]，需显式兜底 */
  .detect-hint[hidden],
  .dl-notice[hidden],
  .dl-size[hidden] {
    display: none;
  }

  .detect-hint svg {
    color: var(--brand);
    flex: none;
  }

  .dl-layout {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 20px;
    align-items: start;
  }

  .dl-picker {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: sticky;
    top: calc(var(--header-h) + 20px);
  }

  .dl-tab {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 50px;
    padding: 10px 16px;
    border: 1px solid transparent;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--text-2);
    font: 600 0.9375rem var(--font-sans);
    cursor: pointer;
    transition: background-color 0.18s var(--ease), color 0.18s var(--ease),
      border-color 0.18s var(--ease);
  }

  .dl-tab:hover {
    color: var(--text);
    background: var(--surface);
  }

  .dl-tab[aria-selected='true'] {
    color: var(--brand);
    background: var(--surface);
    border-color: var(--brand-line);
    box-shadow: var(--shadow-s);
  }

  .dl-panels {
    min-width: 0;
  }

  .dl-panel {
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-s);
  }

  .dl-head {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
  }

  .dl-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--brand-soft);
    color: var(--brand);
  }

  .dl-head h2 {
    font-size: 1.35rem;
  }

  .dl-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 5px;
    font-size: 0.8125rem;
    color: var(--text-3);
  }

  .dl-meta i {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-3);
  }

  .dl-version {
    margin-left: auto;
    font-size: 0.8125rem;
    color: var(--text-2);
    text-align: right;
  }

  .dl-version .ok {
    color: var(--brand);
    font-weight: 660;
  }

  .dl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
  }

  .dl-btn {
    min-width: 200px;
  }

  .dl-alt {
    font-size: 0.875rem;
  }

  .dl-notes {
    list-style: none;
    margin: 22px 0 0;
    padding: 14px 18px;
    border-radius: var(--radius-s);
    background: var(--surface-2);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .dl-notes li {
    position: relative;
    padding-left: 18px;
    font-size: 0.85rem;
    color: var(--text-2);
    line-height: 1.65;
  }

  .dl-notes li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--brand);
    opacity: 0.55;
  }

  .dl-sums {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    font-size: 0.8125rem;
  }

  .dl-sums a {
    color: var(--text-3);
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }

  .dl-sums a:hover {
    color: var(--brand);
  }

  .dl-size {
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .dl-notice {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin-top: 14px;
    padding: 12px 16px;
    border-radius: var(--radius-s);
    border: 1px solid color-mix(in srgb, var(--amber) 36%, transparent);
    background: var(--amber-soft);
    color: var(--text);
    font-size: 0.855rem;
    line-height: 1.65;
  }

  .dl-notice svg {
    color: var(--amber);
    flex: none;
    margin-top: 3px;
  }

  /* 测试版通道 */
  .dev-channel {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 26px;
    padding: clamp(20px, 3vw, 28px);
    border: 1px dashed color-mix(in srgb, var(--amber) 45%, var(--line));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--amber-soft) 55%, var(--surface));
  }

  .dev-info {
    flex: 1;
    min-width: 260px;
  }

  .dev-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 660;
    letter-spacing: 0.12em;
    color: var(--amber);
    border: 1px solid color-mix(in srgb, var(--amber) 40%, transparent);
    border-radius: 999px;
    padding: 2px 10px;
    margin-bottom: 10px;
  }

  .dev-channel h2 {
    font-size: 1.15rem;
    margin-bottom: 6px;
  }

  .dev-channel p {
    font-size: 0.9rem;
    color: var(--text-2);
  }

  .dl-foot {
    margin-top: 30px;
    font-size: 0.875rem;
    color: var(--text-3);
    text-align: center;
  }

  @media (max-width: 860px) {
    .dl-layout {
      grid-template-columns: 1fr;
    }

    .dl-picker {
      position: static;
      flex-direction: row;
      overflow-x: auto;
      gap: 8px;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
    }

    .dl-tab {
      min-height: 44px;
      white-space: nowrap;
      scroll-snap-align: start;
    }

    .dl-version {
      margin-left: 0;
      text-align: left;
      width: 100%;
    }
  }
</style>

<script>
  // Astro 脚本拥有独立模块作用域，需自行导入所依赖的常量。
  import { API } from '../config';
  // ============================================================
  // 下载逻辑：GitHub Releases API → 匹配平台安装包 → 失败回退
  //  - HTML 中的默认链接全部指向 Releases 页面，JS 不可用也能下载
  //  - API 成功：替换为真实下载地址、显示版本号 / 大小 / 日期
  //  - API 失败：保持默认链接并显示提示条
  //  - 结果缓存 10 分钟，减少 API 限流影响
  // ============================================================
  const CACHE_KEY = 'bitree-releases-cache';
  const CACHE_TTL = 10 * 60 * 1000;

  interface Asset {
    name: string;
    size: number;
    browser_download_url: string;
  }
  interface Release {
    tag_name: string;
    published_at: string;
    prerelease: boolean;
    html_url: string;
    assets: Asset[];
  }

  const fmtSize = (b: number) => `${(b / 1048576).toFixed(1)} MB`;
  const fmtDate = (iso: string) =>
    new Date(iso).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

  async function fetchRelease(): Promise<{ latest: Release; dev: Release | null } | null> {
    try {
      const cached = sessionStorage.getItem(CACHE_KEY);
      if (cached) {
        const { t, data } = JSON.parse(cached) as { t: number; data: { latest: Release; dev: Release | null } };
        if (Date.now() - t < CACHE_TTL) return data;
      }
    } catch {
      /* sessionStorage 不可用则跳过缓存 */
    }

    try {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 8000);
      const [latestRes, listRes] = await Promise.all([
        fetch(API.latest, { signal: ctrl.signal, headers: { Accept: 'application/vnd.github+json' } }),
        fetch(API.list, { signal: ctrl.signal, headers: { Accept: 'application/vnd.github+json' } }),
      ]);
      clearTimeout(timer);
      if (!latestRes.ok) throw new Error(`latest ${latestRes.status}`);
      const latest = (await latestRes.json()) as Release;
      let dev: Release | null = null;
      if (listRes.ok) {
        const list = (await listRes.json()) as Release[];
        dev = list.find((r) => r.prerelease) ?? null;
      }
      const data = { latest, dev };
      try {
        sessionStorage.setItem(CACHE_KEY, JSON.stringify({ t: Date.now(), data }));
      } catch {
        /* ignore */
      }
      return data;
    } catch {
      return null;
    }
  }

  function fillPanels(latest: Release) {
    const sums = latest.assets.find((a) => /^SHA256SUMS/i.test(a.name));

    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
      const versionSlot = panel.querySelector<HTMLElement>('[data-slot="version"]');
      if (versionSlot) {
        versionSlot.innerHTML = '';
        const ok = document.createElement('span');
        ok.className = 'ok';
        ok.textContent = latest.tag_name;
        versionSlot.append(ok, ` · 发布于 ${fmtDate(latest.published_at)}`);
      }

      panel.querySelectorAll<HTMLAnchorElement>('.dl-btn').forEach((btn) => {
        const re = new RegExp(btn.dataset.assetRe ?? '$^');
        const asset = latest.assets.find((a) => re.test(a.name));
        if (asset) {
          btn.href = asset.browser_download_url;
          const text = btn.querySelector('[data-btn-text]');
          if (text) text.textContent = `下载 ${btn.dataset.assetLabel}`;
        }
        // 未匹配到资产时保持默认 Releases 链接（回退）
      });

      if (sums) {
        const sumsLink = panel.querySelector<HTMLAnchorElement>('[data-slot="sums"]');
        if (sumsLink) sumsLink.href = sums.browser_download_url;
      }

      const primary = latest.assets.find((a) =>
        new RegExp(panel.querySelector<HTMLAnchorElement>('.dl-btn')?.dataset.assetRe ?? '$^').test(a.name)
      );
      const sizeSlot = panel.querySelector<HTMLElement>('[data-slot="size"]');
      if (primary && sizeSlot) {
        sizeSlot.textContent = `${primary.name} · ${fmtSize(primary.size)}`;
        sizeSlot.hidden = false;
      }
    });
  }

  function fillDevChannel(dev: Release | null) {
    const slot = document.querySelector<HTMLElement>('[data-slot="dev-version"]');
    const link = document.querySelector<HTMLAnchorElement>('[data-slot="dev-link"]');
    if (!slot || !dev) return;
    slot.textContent = `${dev.tag_name}（${fmtDate(dev.published_at)}）`;
    if (link && dev.html_url) link.href = dev.html_url;
  }

  function showNotice() {
    const notice = document.querySelector<HTMLElement>('[data-dl-notice]');
    if (notice) notice.hidden = false;
  }

  // 平台自动检测（可手动切换）
  function detectPlatform(): string {
    const ua = navigator.userAgent;
    if (/Android/i.test(ua)) return 'android';
    if (/iPhone|iPad|iPod/i.test(ua)) return 'ios';
    if (/Windows/i.test(ua)) return 'windows';
    if (/Macintosh|Mac OS X/i.test(ua)) return 'macos';
    return 'linux';
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-platform]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));

  function selectPlatform(id: string, focus = false) {
    let found = false;
    tabs.forEach((t) => {
      const on = t.dataset.platform === id;
      if (on) found = true;
      t.ariaSelected = String(on);
      t.tabIndex = on ? 0 : -1;
    });
    const target = found ? id : 'android';
    panels.forEach((p) => (p.hidden = p.dataset.panel !== target));
    if (focus) tabs.find((t) => t.dataset.platform === target)?.focus();
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => selectPlatform(tab.dataset.platform!));
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (dir) {
        e.preventDefault();
        const nextTab = tabs[(i + dir + tabs.length) % tabs.length];
        if (nextTab) {
          selectPlatform(nextTab.dataset.platform!, true);
          nextTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      }
    });
  });

  const detected = detectPlatform();
  selectPlatform(detected);
  const hint = document.querySelector<HTMLElement>('[data-detect-hint]');
  const nameEl = hint?.querySelector<HTMLElement>('[data-detect-name]');
  if (hint && nameEl) {
    const tab = tabs.find((t) => t.dataset.platform === detected);
    if (tab) {
      nameEl.textContent = tab.textContent?.trim() ?? detected;
      hint.hidden = false;
    }
  }

  const result = await fetchRelease();
  if (result) {
    fillPanels(result.latest);
    fillDevChannel(result.dev);
  } else {
    showNotice();
    document.querySelectorAll<HTMLElement>('[data-slot="version"]').forEach((el) => {
      el.textContent = '版本获取失败，下载按钮将打开 Releases 页面';
    });
  }
</script>
